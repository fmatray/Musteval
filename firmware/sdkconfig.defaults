# Flash: 8 MiB quad SPI part on the R8 module (docs/01-hardware.md §4, notes table)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM: 8 MiB octal on the R8 module (docs/01-hardware.md §2, §4 notes table)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# PSRAM is not general heap without this (docs/01-hardware.md §2)
CONFIG_SPIRAM_USE_MALLOC=y
# A TLS handshake allocates its input buffer from the internal pool by default:
# `MBEDTLS_SSL_IN_CONTENT_LEN` is 16384 and `SPIRAM_MALLOC_ALWAYSINTERNAL` is 16384, so
# every handshake takes the whole DMA-capable pool and the WiFi driver's next allocation
# fails (`wifi:m f null`), which surfaced as `ESP_ERR_HTTP_CONNECT`. Move both the TLS
# buffers and the WiFi/LWIP pools into the 8 MiB part; internal SRAM is then left to the
# DMA descriptors that alone can use it.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Custom partition table (docs/01-hardware.md §4)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Watchdog: sys_init() owns it (docs/02-firmware.md §3.1 step 2). With IDF's own
# init left on, esp_task_wdt_init() returns ESP_ERR_INVALID_STATE and logs an error
# every boot, and its idle-task subscription contradicts idle_core_mask = 0.
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Optimise for size, not for debug: `-Og` produced a 1 190 193-byte image and `-Os`
# produces 1 082 543, a 9% saving on a part where the app partition is fixed at 3 MiB
# (`partitions.csv`). ESP-IDF's own guidance lists this as the first lever. The cost
# is that a crash backtrace has fewer optimisations to unwind, which matters only
# when debugging on a board that a serial probe can reach anyway.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Dynamic frequency scaling (docs/08-code-architecture.md §5.3): 160 MHz under a run,
# 80 MHz otherwise. Light sleep stays off because docs/01-hardware.md §5 requires the
# device to answer `ping` and fire `schedule` triggers while the link is open, and
# light sleep is what breaks that (§5.4). Tickless idle is left off for the same
# reason: on ESP-IDF it *is* automatic light sleep.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
